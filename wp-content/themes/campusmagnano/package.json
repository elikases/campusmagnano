{
  "name": "campusmagnano",
  "version": "1.0.0",
  "description": "Theme de Campus Magnano, basado en Underscores (_s).",
  "author": "Campus Magnano",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "WordPress",
    "Theme"
  ],
  "private": true,
  "rtlcssConfig": {
    "options": {
      "autoRename": false,
      "autoRenameStrict": false,
      "blacklist": {},
      "clean": true,
      "greedy": false,
      "processUrls": false,
      "stringMap": []
    },
    "plugins": [],
    "map": false
  },
  "scripts": {
    "watch": "sass --watch --style=expanded --no-source-map --silence-deprecation=import sass/styles.scss:css/styles.css",
    "compile:css": "sass --style=expanded --no-source-map --silence-deprecation=import sass/styles.scss:css/styles.css",
    "compile:rtl": "rtlcss style.css style-rtl.css",
    "lint:scss": "stylelint 'sass/**/*.scss'",
    "lint:js": "eslint 'js/*.js'"
  },
  "devDependencies": {
    "sass": "^1.80.6"
  }
}
